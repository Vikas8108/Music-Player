                cover: "🌌"
            },
            {
                id: 102,
                title: "Crystal Waves (Demo)",
                artist: "Acoustic Dreams",
                album: "WAV Collection",
                singer: "Acoustic Dreams",
                duration: "3:10",
                url: "https://cdn.pixabay.com/download/audio/2022/01/18/audio_d0a13f69d2.mp3?filename=peaceful-guitar-ambient-lofi-104995.mp3",
                cover: "🌊"
            }
        ];

        let playlists = [
            { id: 1, name: "Phone Favorites", trackIds: [101] },
            { id: 2, name: "Chill & Relax", trackIds: [102] }
        ];

        let currentTab = 'tracks';
        let currentTrackIndex = 0;
        let isPlaying = false;
        let isShuffle = false;
        let playMode = 0; // 0: Normal (Stop at end), 1: Loop All, 2: Single Track Repeat
        let favorites = [101];

        const audioElement = document.getElementById('audio-element');
        const playPauseBtn = document.getElementById('play-pause-btn');
        const playPauseIcon = document.getElementById('play-pause-icon');
        const progressBar = document.getElementById('progress-bar');
        const progressContainer = document.getElementById('progress-container');
        const currentTimeEl = document.getElementById('current-time');
        const totalDurationEl = document.getElementById('total-duration');
        const vinylDisc = document.getElementById('vinyl-disc');
        const playerView = document.getElementById('player-view');

        // Initialize App on load
        window.onload = function() {
            switchTab('tracks');
            loadTrack(0, false);

            // Audio event listeners
            audioElement.addEventListener('timeupdate', updateProgress);
            audioElement.addEventListener('ended', handleTrackEnded);
            audioElement.addEventListener('loadedmetadata', () => {
                if(!isNaN(audioElement.duration)) {
                    totalDurationEl.innerText = formatTime(audioElement.duration);
                }
            });
        };

        // Handle Local Phone Audio File Selection (Supports MP3, WAV, FLAC, AAC, OGG, M4A, etc.)
        function handleLocalFilesSelected(event) {
            const files = event.target.files;
            if (!files || files.length === 0) return;

            let addedCount = 0;
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                // Verify if it's an audio file or supports mp3, wav, etc.
                if (file.type.startsWith('audio/') || file.name.match(/\.(mp3|wav|flac|aac|ogg|m4a|wma)$/i)) {
                    const fileUrl = URL.createObjectURL(file);
                    
                    // Parse metadata from filename
                    const cleanName = file.name.replace(/\.[^/.]+$/, "");
                    const nameParts = cleanName.split("-");
                    let artist = "Local Device";
                    let title = cleanName;
                    if(nameParts.length > 1) {
                        artist = nameParts[0].trim();
                        title = nameParts.slice(1).join("-").trim();
                    }

                    const newTrack = {
                        id: Date.now() + i,
                        title: title,
                        artist: artist,
                        album: "Phone Local Storage",
                        singer: artist,
                        duration: "3:30",
                        url: fileUrl,
                        cover: getAudioIcon(file.name)
                    };

                    tracks.push(newTrack);
                    addedCount++;
                }
            }

            if (addedCount > 0) {
                showToast(`Successfully added ${addedCount} music file(s) from phone!`);
                if (tracks.length === addedCount) {
                    loadTrack(0, false);
                }
                renderContentPanel();
            } else {
                showToast("Please select valid music files (MP3, WAV, FLAC, etc.)");
            }
        }

        function getAudioIcon(filename) {
            if (filename.endsWith('.wav')) return '🌊';
            if (filename.endsWith('.flac')) return '💎';
            if (filename.endsWith('.aac')) return '🎵';
            return '🎶';
        }

        // Tab Switching Logic
        function switchTab(tabName) {
            currentTab = tabName;
            
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('bg-white/25', 'text-white', 'shadow-lg');
                btn.classList.add('text-white/70', 'hover:text-white', 'hover:bg-white/10');
            });
            const activeBtn = document.getElementById(`tab-${tabName}`);
            if(activeBtn) {
                activeBtn.classList.remove('text-white/70', 'hover:text-white', 'hover:bg-white/10');
                activeBtn.classList.add('bg-white/25', 'text-white', 'shadow-lg');
            }

            renderContentPanel();
        }

        // Render Content based on active tab
        function renderContentPanel() {
            const panel = document.getElementById('content-panel');
            let html = '';

            if (currentTab === 'tracks') {
                html = `
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-lg font-bold text-white/90">Phone Tracks (${tracks.length})</h3>
                        <button onclick="document.getElementById('local-file-input').click()" class="text-xs text-cyan-400 hover:underline font-medium">+ Add Phone Music</button>
                    </div>
                    <div class="space-y-2">
                `;
                
                tracks.forEach((track, index) => {
                    const isCurrent = index === currentTrackIndex;
                    const isFav = favorites.includes(track.id);
                    html += `
                        <div onclick="playTrackIndex(${index})" class="glass-card p-3 rounded-2xl flex items-center justify-between cursor-pointer transition-all ${isCurrent ? 'border-cyan-400/50 bg-white/15' : ''}">
                            <div class="flex items-center space-x-3 overflow-hidden">
                                <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-lg flex-shrink-0">${track.cover}</div>
                                <div class="overflow-hidden">
                                    <h4 class="text-sm font-semibold truncate ${isCurrent ? 'text-cyan-300' : 'text-white'}">${track.title}</h4>
                                    <p class="text-xs text-white/50 truncate">${track.artist}</p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-3 flex-shrink-0">
                                <button onclick="event.stopPropagation(); toggleFavorite(${track.id})" class="text-white/60 hover:text-cyan-400 p-1">
                                    <i class="${isFav ? 'fa-solid text-cyan-400' : 'fa-regular'} fa-heart"></i>
                                </button>
                            </div>
                        </div>
                    `;
                });
                html += `</div>`;
            } else if (currentTab === 'playlist') {
                html = `
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-lg font-bold text-white/90">Playlists</h3>
                        <button onclick="openPlaylistModal()" class="w-8 h-8 rounded-xl bg-cyan-500 text-slate-950 font-bold flex items-center justify-center shadow-lg hover:scale-105 transition-transform" title="Create Playlist">
                            <i class="fa-solid fa-plus"></i>
                        </button>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                `;
                playlists.forEach(pl => {
                    html += `
                        <div onclick="showToast('Playlist: ${pl.name}')" class="glass-card p-4 rounded-2xl flex items-center justify-between cursor-pointer hover:border-cyan-400/40">
                            <div class="flex items-center space-x-3">
                                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-500/30 to-purple-500/30 flex items-center justify-center text-xl">📁</div>
                                <div>
                                    <h4 class="text-sm font-bold text-white">${pl.name}</h4>
                                    <p class="text-xs text-white/50">${pl.trackIds.length} tracks</p>
                                </div>
                            </div>
                            <i class="fa-solid fa-chevron-right text-white/30 text-xs"></i>
                        </div>
                    `;
                });
                html += `</div>`;
            } else if (currentTab === 'favorites') {
                const favTracks = tracks.filter(t => favorites.includes(t.id));
                html = `<h3 class="text-lg font-bold mb-3 text-white/90">Favorites (${favTracks.length})</h3><div class="space-y-2">`;
                if(favTracks.length === 0) {
                    html += `<div class="text-center py-10 text-white/40 text-sm">No favorite tracks yet. Tap the heart icon on any song!</div>`;
                } else {
                    favTracks.forEach((track) => {
                        const originalIndex = tracks.findIndex(t => t.id === track.id);
                        html += `
                            <div onclick="playTrackIndex(${originalIndex})" class="glass-card p-3 rounded-2xl flex items-center justify-between cursor-pointer">
                                <div class="flex items-center space-x-3 overflow-hidden">
                                    <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-lg flex-shrink-0">${track.cover}</div>
                                    <div class="overflow-hidden">
                                        <h4 class="text-sm font-semibold text-white truncate">${track.title}</h4>
                                        <p class="text-xs text-white/50 truncate">${track.artist}</p>
                                    </div>
                                </div>
                                <button onclick="event.stopPropagation(); toggleFavorite(${track.id})" class="text-cyan-400 p-1">
                                    <i class="fa-solid fa-heart"></i>
                                </button>
                            </div>
                        `;
                    });
                }
                html += `</div>`;
            } else if (currentTab === 'albums') {
                const albums = [...new Set(tracks.map(t => t.album))];
                html = `<h3 class="text-lg font-bold mb-3 text-white/90">Albums (${albums.length})</h3><div class="grid grid-cols-2 gap-3">`;
                albums.forEach(album => {
                    html += `
                        <div onclick="showToast('Album: ${album}')" class="glass-card p-4 rounded-2xl flex flex-col items-center text-center cursor-pointer hover:border-cyan-400/40">
                            <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-cyan-500/20 to-indigo-600/20 flex items-center justify-center text-3xl mb-2">💿</div>
                            <h4 class="text-sm font-bold text-white truncate w-full">${album}</h4>
                            <p class="text-xs text-white/50 truncate w-full">Local Phone Audio</p>
                        </div>
                    `;
                });
                html += `</div>`;
            } else if (currentTab === 'singers') {
                const singers = [...new Set(tracks.map(t => t.singer))];
                html = `<h3 class="text-lg font-bold mb-3 text-white/90">Singers / Artists (${singers.length})</h3><div class="space-y-2">`;
                singers.forEach(singer => {
                    html += `
                        <div onclick="showToast('Artist: ${singer}')" class="glass-card p-3 rounded-2xl flex items-center space-x-3 cursor-pointer hover:border-cyan-400/40">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-pink-500/30 to-purple-600/30 flex items-center justify-center text-sm font-bold">🎤</div>
                            <div>
                                <h4 class="text-sm font-semibold text-white">${singer}</h4>
                                <p class="text-xs text-white/50">${tracks.filter(t=>t.singer===singer).length} track(s)</p>
                            </div>
                        </div>
                    `;
                });
                html += `</div>`;
            }

            panel.innerHTML = html;
        }

        // Load Track into audio element and UI
        function loadTrack(index, autoPlay = true) {
            if (tracks.length === 0) return;
            currentTrackIndex = index;
            const track = tracks[currentTrackIndex];

            audioElement.src = track.url;
            document.getElementById('current-title').innerText = track.title;
            document.getElementById('current-artist').innerText = track.artist;
            document.getElementById('mini-title').innerText = track.title;
            document.getElementById('mini-artist').innerText = track.artist;
            document.getElementById('mini-thumb').innerText = track.cover;
            document.getElementById('vinyl-center-art').innerText = track.cover;

            updateFavoriteUI();

            if (autoPlay) {
                playAudio();
            } else {
                pauseAudio();
            }

            if (currentTab === 'tracks' || currentTab === 'favorites') {
                renderContentPanel();
            }
        }

        // Play / Pause toggles
        function togglePlayPause() {
            if (tracks.length === 0) return;
            if (isPlaying) {
                pauseAudio();
            } else {
                playAudio();
            }
        }

        function playAudio() {
            audioElement.play().then(() => {
                isPlaying = true;
                playPauseIcon.className = "fa-solid fa-pause";
                vinylDisc.classList.remove('paused');
            }).catch(err => {
                console.log("Playback error or blocked:", err);
            });
        }

        function pauseAudio() {
            audioElement.pause();
            isPlaying = false;
            playPauseIcon.className = "fa-solid fa-play ml-0.5";
            vinylDisc.classList.add('paused');
        }

        function playTrackIndex(index) {
            loadTrack(index, true);
        }

        function nextTrack() {
            if (tracks.length === 0) return;
            let nextIdx;
            if (isShuffle) {
                nextIdx = Math.floor(Math.random() * tracks.length);
            } else {
                nextIdx = (currentTrackIndex + 1) % tracks.length;
            }
            loadTrack(nextIdx, true);
        }

        function prevTrack() {
            if (tracks.length === 0) return;
            let prevIdx = (currentTrackIndex - 1 + tracks.length) % tracks.length;
            loadTrack(prevIdx, true);
        }

        // Track Progress Update
        function updateProgress() {
            if(isNaN(audioElement.duration)) return;
            const progressPercent = (audioElement.currentTime / audioElement.duration) * 100;
            progressBar.style.width = `${progressPercent}%`;
            currentTimeEl.innerText = formatTime(audioElement.currentTime);
        }

        function seekTrack(event) {
            const width = progressContainer.clientWidth;
            const clickX = event.offsetX;
            const duration = audioElement.duration;
            if(!isNaN(duration)) {
                audioElement.currentTime = (clickX / width) * duration;
            }
        }

        function formatTime(seconds) {
            const mins = Math.floor(seconds / 60);
            const secs = Math.floor(seconds % 60);
            return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }

        // Track Ended Handler according to Play Mode
        function handleTrackEnded() {
            if (playMode === 2) {
                // Single Track Repeat
                audioElement.currentTime = 0;
                playAudio();
            } else if (playMode === 1 || currentTrackIndex < tracks.length - 1) {
                // Loop All or normal sequence
                nextTrack();
            } else {
                pauseAudio();
            }
        }

        // Shuffle Toggle (Bottom-left corner)
        function toggleShuffle() {
            isShuffle = !isShuffle;
            const btn = document.getElementById('shuffle-btn');
            if (isShuffle) {
                btn.classList.add('text-cyan-400', 'bg-white/20');
                btn.classList.remove('text-white/60', 'glass-card');
                showToast("Shuffle Enabled");
            } else {
                btn.classList.remove('text-cyan-400', 'bg-white/20');
                btn.classList.add('text-white/60', 'glass-card');
                showToast("Shuffle Disabled");
            }
        }

        // Single Combined Play Mode Button (Bottom-right corner)
        // Cycles: 0 -> Normal, 1 -> Loop All, 2 -> Single Track Repeat
        function cyclePlayMode() {
            playMode = (playMode + 1) % 3;
            const btn = document.getElementById('mode-btn');
            const badge = document.getElementById('mode-badge');

            if (playMode === 0) {
                btn.classList.remove('text-cyan-400', 'bg-white/20');
                btn.classList.add('text-white/60', 'glass-card');
                badge.classList.add('hidden');
                showToast("Playback Mode: Normal");
            } else if (playMode === 1) {
                btn.classList.add('text-cyan-400', 'bg-white/20');
                btn.classList.remove('text-white/60', 'glass-card');
                badge.classList.add('hidden');
                showToast("Playback Mode: Loop All");
            } else if (playMode === 2) {
                btn.classList.add('text-cyan-400', 'bg-white/20');
                badge.classList.remove('hidden');
                showToast("Playback Mode: Single Track Repeat");
            }
        }

        // Favorites Handling
        function toggleFavorite(trackId) {
            const index = favorites.indexOf(trackId);
            if (index > -1) {
                favorites.splice(index, 1);
                showToast("Removed from Favorites");
            } else {
                favorites.push(trackId);
                showToast("Added to Favorites");
            }
            updateFavoriteUI();
            if (currentTab === 'favorites' || currentTab === 'tracks') {
                renderContentPanel();
            }
        }

        function toggleFavoriteCurrent() {
            if(tracks.length === 0) return;
            const currentTrack = tracks[currentTrackIndex];
            toggleFavorite(currentTrack.id);
        }

        function updateFavoriteUI() {
            if (tracks.length === 0) return;
            const currentTrack = tracks[currentTrackIndex];
            const isFav = favorites.includes(currentTrack.id);
            const miniFav = document.getElementById('mini-fav-icon');
            const expFav = document.getElementById('expanded-fav-icon');

            if (isFav) {
                miniFav.className = "fa-solid fa-heart text-lg text-cyan-400";
                expFav.className = "fa-solid fa-heart text-lg text-cyan-400";
            } else {
                miniFav.className = "fa-regular fa-heart text-lg";
                expFav.className = "fa-regular fa-heart text-lg";
            }
        }

        // Playlist Modals
        function openPlaylistModal() {
            document.getElementById('playlist-modal').classList.remove('hidden');
            document.getElementById('new-playlist-name').value = '';
        }

        function closePlaylistModal() {
            document.getElementById('playlist-modal').classList.add('hidden');
        }

        function saveNewPlaylist() {
            const name = document.getElementById('new-playlist-name').value.trim();
            if(!name) {
                showToast("Please enter a playlist name");
                return;
            }
            playlists.push({
                id: Date.now(),
                name: name,
                trackIds: []
            });
            closePlaylistModal();
            showToast(`Playlist "${name}" created successfully!`);
            if(currentTab === 'playlist') {
                renderContentPanel();
            }
        }

        // APK Modal
        function openApkModal() {
            document.getElementById('apk-modal').classList.remove('hidden');
        }
        function closeApkModal() {
            document.getElementById('apk-modal').classList.add('hidden');
        }

        function downloadManifestAndFiles() {
            const manifestData = {
                name: "MUSIC",
                short_name: "MUSIC",
                start_url: "/",
                display: "standalone",
                background_color: "#030712",
                theme_color: "#030712",
                icons: []
            };
            const blob = new Blob([JSON.stringify(manifestData, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = "manifest.json";
            a.click();
            showToast("Downloaded WebAPK manifest.json successfully!");
        }

        // Toggle Full Expanded Player View
        function togglePlayerView() {
            if (playerView.classList.contains('translate-y-full')) {
                playerView.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
            } else {
                playerView.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
            }
        }

        // Toast Notification Helper
        let toastTimeout;
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = message;
            toast.classList.remove('hidden');
            
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }
    </script>
</body>
</html>
