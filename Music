    <script>
        // State storage for tracks stored in phone / added locally + ambient default demo tracks
        let tracks = [
            {
                id: 101,
                title: "Ambient Horizon (Demo)",
                artist: "Phone Audio Library",
                album: "Ambient Sessions",
                singer: "Phone Library",
                duration: "2:45",
